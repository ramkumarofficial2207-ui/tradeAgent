# StockSage AI — Environment Variables
# Copy this to .env and fill in real values

# ── Database ──────────────────────────────────────────────────
# PostgreSQL is required in development and production:
DATABASE_URL="postgresql://user:password@host:5432/stocksage?schema=public"
# Production Railway DB URL — used by scratch_backfill_deals.ts --prod flag
PROD_DATABASE_URL=""

# ── Auth ──────────────────────────────────────────────────────
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
CORS_ALLOWED_ORIGINS="http://localhost:5173"
ADMIN_EMAILS="admin@example.com"

# ── AI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Broker secrets are server-only. Do not store them in frontend variables or files.
BROKER_PROVIDER="paper"
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_ACCESS_TOKEN=""

# Trading remains paper-only unless both controls are explicitly enabled.
PAPER_TRADING_MODE="true"
ENABLE_LIVE_TRADING="false"
ENABLE_AUTOMATION="false"

# Scheduled market scans are independent from paper-trade execution.
ENABLE_AUTO_SCAN="false"
SCAN_TIMEOUT_MS="600000"
SCANNER_UNIVERSE_LIMIT="500"
SCANNER_CONCURRENCY="12"
SCANNER_DEEP_CANDIDATE_LIMIT="30"
MARKET_DATA_TIMEOUT_MS="8000"
# Optional comma-separated YYYY-MM-DD NSE holiday dates.
NSE_MARKET_HOLIDAYS=""

# ── Optional ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development         # set to "production" on server

# For Docker Compose only:
# POSTGRES_PASSWORD="your_db_password"
